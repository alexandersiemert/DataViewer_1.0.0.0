<Window x:Class="Siemert.DataViewer.App.Views.LiveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sp="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        Title="Momentanwerte"
        Width="900" Height="660" MinWidth="720" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource UiFont}"
        Background="{StaticResource SurfaceBrush}"
        Loaded="OnLoaded" Closing="OnClosing">

    <StackPanel Margin="20">

        <TextBlock Text="Momentanwerte des Loggers"
                   FontSize="{StaticResource FontSizeSubtitle}" FontWeight="SemiBold"
                   Foreground="{StaticResource TextPrimaryBrush}"/>

        <TextBlock x:Name="DeviceLine" Style="{StaticResource FieldLabel}" Margin="0,4,0,0"
                   TextWrapping="Wrap"/>

        <!-- Druck und Temperatur stammen aus Befehl D, die Beschleunigung aus Befehl M. -->
        <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12,10,12,11">
                <StackPanel>
                    <TextBlock Text="DRUCK" Style="{StaticResource SectionHeader}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock x:Name="PressureValue" Text="&#8211;" FontSize="24" FontWeight="SemiBold"
                                   FontFamily="{StaticResource NumericFont}"
                                   Foreground="{StaticResource SeriesAltitudeBrush}"/>
                        <TextBlock Text="hPa" FontSize="11" Margin="4,0,0,4" VerticalAlignment="Bottom"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12,10,12,11">
                <StackPanel>
                    <TextBlock Text="TEMPERATUR" Style="{StaticResource SectionHeader}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock x:Name="TemperatureValue" Text="&#8211;" FontSize="24" FontWeight="SemiBold"
                                   FontFamily="{StaticResource NumericFont}"
                                   Foreground="{StaticResource SeriesTemperatureBrush}"/>
                        <TextBlock Text="°C" FontSize="11" Margin="4,0,0,4" VerticalAlignment="Bottom"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource Card}" Padding="12,10,12,11">
                <StackPanel>
                    <TextBlock Text="BESCHLEUNIGUNG" Style="{StaticResource SectionHeader}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock x:Name="AccValue" Text="&#8211;" FontSize="24" FontWeight="SemiBold"
                                   FontFamily="{StaticResource NumericFont}"
                                   Foreground="{StaticResource SeriesAccBrush}"/>
                        <TextBlock Text="g" FontSize="11" Margin="4,0,0,4" VerticalAlignment="Bottom"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="6" Padding="14,11,14,12" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Achse X" Style="{StaticResource FieldLabel}"/>
                <TextBlock x:Name="AccX" Grid.Row="0" Grid.Column="1" Text="&#8211;" Margin="8,0,0,0"
                           FontFamily="{StaticResource NumericFont}"
                           Foreground="{StaticResource TextPrimaryBrush}"/>

                <TextBlock Grid.Row="0" Grid.Column="2" Text="Achse Y" Style="{StaticResource FieldLabel}"/>
                <TextBlock x:Name="AccY" Grid.Row="0" Grid.Column="3" Text="&#8211;" Margin="8,0,0,0"
                           FontFamily="{StaticResource NumericFont}"
                           Foreground="{StaticResource TextPrimaryBrush}"/>

                <TextBlock Grid.Row="0" Grid.Column="4" Text="Achse Z" Style="{StaticResource FieldLabel}"/>
                <TextBlock x:Name="AccZ" Grid.Row="0" Grid.Column="5" Text="&#8211;" Margin="8,0,0,0"
                           FontFamily="{StaticResource NumericFont}"
                           Foreground="{StaticResource TextPrimaryBrush}"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Höhe" Style="{StaticResource FieldLabel}"
                           Margin="0,7,0,0"/>
                <TextBlock x:Name="AltitudeValue" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="5"
                           Text="&#8211;" Margin="8,7,0,0"
                           FontFamily="{StaticResource NumericFont}"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
            </Grid>
        </Border>

        <!-- Verlauf der Momentanwerte. Gleiche Stilgebung wie das Hauptdiagramm. -->
        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1" CornerRadius="7" Margin="0,12,0,0" Height="270">
            <sp:WpfPlot x:Name="LivePlot" Margin="3"/>
        </Border>

        <Border x:Name="StateBox" Style="{StaticResource NoticeBox}" Margin="0,10,0,0">
            <TextBlock x:Name="StateText" TextWrapping="Wrap" FontSize="{StaticResource FontSizeBody}"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <TextBlock x:Name="CounterText" Style="{StaticResource FieldLabel}"
                       VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Button x:Name="PauseButton" Content="Anhalten" Style="{StaticResource ToolButton}"
                    Height="30" Width="108" Click="OnTogglePause"/>
            <Button Content="Schließen" Style="{StaticResource ActionButton}" Width="126" Margin="8,0,0,0"
                    IsCancel="True" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
